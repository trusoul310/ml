
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LinearRegression, Ridge
from sklearn.metrics import mean_squared_error, r2_score

# Load Dataset
df = pd.read_csv(r"C:\Downloads\california_housing.csv")
print(df.head())
print(df.shape)
print(df.isnull().sum())

# Select Features and Target
X = df.drop('MedHouseVal', axis=1)
y = df['MedHouseVal']

# Split Dataset
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42)

# Feature Scaling
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# Linear Regression
linear_model = LinearRegression()
linear_model.fit(X_train_scaled, y_train)

# Ridge Regression
ridge_model = Ridge(alpha=1.0)
ridge_model.fit(X_train_scaled, y_train)

# Evaluate Models
for name, model in [('Linear Regression', linear_model), ('Ridge Regression', ridge_model)]:
    y_train_pred = model.predict(X_train_scaled)
    y_test_pred = model.predict(X_test_scaled)
    print("\n", name)
    print("Training MSE =", mean_squared_error(y_train, y_train_pred))
    print("Testing MSE =", mean_squared_error(y_test, y_test_pred))
    print("Testing RMSE =", np.sqrt(mean_squared_error(y_test, y_test_pred)))
    print("Training R2 =", r2_score(y_train, y_train_pred))
    print("Testing R2 =", r2_score(y_test, y_test_pred))

# Compare Coefficients
coefficients = pd.DataFrame({
    'Feature': X.columns,
    'Linear': linear_model.coef_,
    'Ridge': ridge_model.coef_
})
print("\nRegression Coefficients:")
print(coefficients)

# Compare Different Alpha Values
alphas = [0.01, 0.1, 1, 10, 100, 1000]
train_mse = []
test_mse = []

for alpha in alphas:
    model = Ridge(alpha=alpha)
    model.fit(X_train_scaled, y_train)
    train_mse.append(mean_squared_error(y_train, model.predict(X_train_scaled)))
    test_mse.append(mean_squared_error(y_test, model.predict(X_test_scaled)))

# Plot Training and Testing Error
plt.figure(figsize=(10, 6))
plt.plot(alphas, train_mse, marker='o', label='Training MSE')
plt.plot(alphas, test_mse, marker='o', label='Testing MSE')
plt.xscale('log')
plt.xlabel('Alpha')
plt.ylabel('Mean Squared Error')
plt.title('Effect of Ridge Regularization')
plt.legend()
plt.grid(True)
plt.show()

# Plot Coefficients
coefficients.set_index('Feature').plot(kind='bar', figsize=(10, 6))
plt.title('Linear vs Ridge Regression Coefficients')
plt.xlabel('Features')
plt.ylabel('Coefficient Value')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()

# Actual vs Predicted Values
y_pred = ridge_model.predict(X_test_scaled)
plt.figure(figsize=(8, 6))
plt.scatter(y_test, y_pred, alpha=0.5)
plt.xlabel('Actual Values')
plt.ylabel('Predicted Values')
plt.title('Ridge Regression: Actual vs Predicted')
plt.grid(True)
plt.show()
