import pandas as pd
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

# Load Dataset
df = pd.read_csv(r"C:\Downloads\iris.csv")
print(df.head())
print(df.shape)
print(df.isnull().sum())

# Select Features
X = df.drop('target', axis=1)

# Feature Scaling
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Elbow Method
wcss = []
for k in range(1, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    model.fit(X_scaled)
    wcss.append(model.inertia_)

# Plot Elbow Curve
plt.figure(figsize=(8, 5))
plt.plot(range(1, 11), wcss, marker='o')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('WCSS')
plt.title('Elbow Method')
plt.xticks(range(1, 11))
plt.grid(True)
plt.show()

# Silhouette Method
silhouette_scores = []
for k in range(2, 11):
    model = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = model.fit_predict(X_scaled)
    score = silhouette_score(X_scaled, labels)
    silhouette_scores.append(score)
    print("K =", k, "Silhouette Score =", round(score, 4))

# Find Optimal K
optimal_k = range(2, 11)[silhouette_scores.index(max(silhouette_scores))]
print("\nOptimal Number of Clusters =", optimal_k)

# Plot Silhouette Scores
plt.figure(figsize=(8, 5))
plt.plot(range(2, 11), silhouette_scores, marker='o')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('Silhouette Score')
plt.title('Silhouette Method')
plt.xticks(range(2, 11))
plt.grid(True)
plt.show()

# Apply K-Means with Optimal K
final_model = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
cluster_labels = final_model.fit_predict(X_scaled)

# Display Clustered Data
df['Cluster'] = cluster_labels
print("\nClustered Data:")
print(df.head(10))

# Display Cluster Centers
print("\nCluster Centers:")
print(final_model.cluster_centers_)

# Visualize Clusters
plt.figure(figsize=(8, 6))
plt.scatter(X_scaled[:, 0], X_scaled[:, 1], c=cluster_labels, cmap='viridis', s=50)
plt.xlabel('Sepal Length (Standardized)')
plt.ylabel('Sepal Width (Standardized)')
plt.title('K-Means Clustering on Iris Dataset')
plt.grid(True)
plt.show()

# Final Silhouette Score
final_score = silhouette_score(X_scaled, cluster_labels)
print("\nFinal Silhouette Score =", round(final_score, 4))
